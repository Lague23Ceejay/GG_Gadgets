# Copy this file to .env and fill in real values.
# Local dev — points at your Express backend running locally.
VITE_API_URL=http://localhost:3000/api/v1

# Production (Vercel) — set this in Vercel's Environment Variables UI
# to wherever your backend is deployed, e.g.:
# VITE_API_URL=https://gg-gadgets-api.onrender.com/api/v1
